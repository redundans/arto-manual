<!DOCTYPE html>
<html lang="sv-SE">
<head><meta charset="utf-8"><title>Glömt lösenord</title><!-- INJECT_CSS --></head>
<body class="login login-action-lostpassword wp-core-ui locale-sv-se" data-viewport="web">
<div id="login">
<h1 role="presentation" class="wp-login-logo"><a href="#" style="display:flex;align-items:center;justify-content:center;width:84px;height:84px;margin:0 auto 25px;background:none;text-indent:0">
